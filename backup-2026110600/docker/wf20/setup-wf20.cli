embed-host-controller --domain-config=domain.xml --host-config=host.xml

# Configure server-one to run in HA server group (full-ha profile) with offset 0
/host=master/server-config=server-one:write-attribute(name=group, value=other-server-group)
/host=master/server-config=server-one:write-attribute(name=socket-binding-port-offset, value=0)
/host=master/server-config=server-two:write-attribute(name=auto-start, value=false)

# Configure outbound socket binding pointing to WildFly 41 (port 8180)
/socket-binding-group=full-ha-sockets/remote-destination-outbound-socket-binding=wf41-outbound:add(host="wf41-domain", port=8180)

# Configure Undertow reverse-proxy handler pointing to WildFly 41
/profile=full-ha/subsystem=undertow/configuration=handler/reverse-proxy=wf41-handler:add()
/profile=full-ha/subsystem=undertow/configuration=handler/reverse-proxy=wf41-handler/host=wf41-backend:add(outbound-socket-binding="wf41-outbound", scheme="http", instance-id="wf41", path="/")

# Deploy sample application as ROOT.war to other-server-group
deploy /opt/jboss/wildfly/wf20-app.war --name=ROOT.war --server-groups=other-server-group

stop-embedded-host-controller
